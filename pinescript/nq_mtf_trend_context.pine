//@version=6
indicator("NQ Multi-Timeframe Trend Context", shorttitle="MTF Trend", overlay=true)

// ---------- Inputs ----------
grpCore = "Core Engine"
fractalN     = input.int(2, "Swing fractal bars (each side)", minval=1, maxval=10, group=grpCore)
lenL         = input.int(50, "Regression / efficiency lookback (bars)", minval=5, maxval=500, group=grpCore)
slopeThresh  = input.float(1.5, "Slope significance (t-stat)", minval=0.1, step=0.1, group=grpCore)
hystH        = input.int(2, "Hysteresis (bars to confirm a flip)", minval=1, maxval=10, group=grpCore)
atrLen       = input.int(14, "ATR length (volatility floor)", minval=1, group=grpCore)
volFloorMult = input.float(10.0, "Volatility floor (x min tick)", minval=0.0, group=grpCore)
waitForClose = input.bool(true, "Higher timeframes: wait for confirmed close (no repaint)", group=grpCore)

grpTF = "Timeframes"
useTF2 = input.bool(true, "Enable", inline="tf2", group=grpTF)
tf2    = input.timeframe("60", "Timeframe 2", inline="tf2", group=grpTF)
useTF3 = input.bool(true, "Enable", inline="tf3", group=grpTF)
tf3    = input.timeframe("240", "Timeframe 3", inline="tf3", group=grpTF)
useTF4 = input.bool(true, "Enable", inline="tf4", group=grpTF)
tf4    = input.timeframe("D", "Timeframe 4", inline="tf4", group=grpTF)
useTF5 = input.bool(false, "Enable", inline="tf5", group=grpTF)
tf5    = input.timeframe("W", "Timeframe 5", inline="tf5", group=grpTF)

grpVis = "Visuals"
showBg      = input.bool(true, "Color chart background by primary trend", group=grpVis)
showBars    = input.bool(false, "Color candles by primary trend", group=grpVis)
showTable   = input.bool(true, "Show multi-timeframe table", group=grpVis)
tablePosStr = input.string("Top Right", "Table position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=grpVis)
bgOpacity   = input.int(85, "Background transparency", minval=0, maxval=95, group=grpVis)

grpColor = "Colors"
cUp    = input.color(color.new(color.green, 0), "Up", group=grpColor)
cDown  = input.color(color.new(color.red, 0), "Down", group=grpColor)
cMixed = input.color(color.new(color.orange, 0), "Mixed / Transition", group=grpColor)
cInsuf = input.color(color.new(color.gray, 40), "Insufficient data", group=grpColor)

// ---------- Core engine ----------
// State codes: 0 = insufficient, 1 = up, -1 = down, 2 = mixed
f_calc(_fractalN, _lenL, _thresh, _hystH, _atrLen, _volFloorMult, _waitForClose) =>
    ph = ta.pivothigh(_fractalN, _fractalN)
    pl = ta.pivotlow(_fractalN, _fractalN)

    var float sh1 = na
    var float sh2 = na
    var float sl1 = na
    var float sl2 = na
    if not na(ph)
        sh2 := sh1
        sh1 := ph
    if not na(pl)
        sl2 := sl1
        sl1 := pl

    structDir = na(sh1) or na(sh2) or na(sl1) or na(sl2) ? 0 : (sh1 > sh2 and sl1 > sl2 ? 1 : (sh1 < sh2 and sl1 < sl2 ? -1 : 2))

    idx = float(bar_index)
    r = ta.correlation(close, idx, _lenL)
    denom = 1 - r * r
    tstat = denom > 0.0001 ? r * math.sqrt(_lenL - 2) / math.sqrt(denom) : (r > 0 ? 999.0 : -999.0)
    atrVal = ta.atr(_atrLen)
    insufficientSlope = bar_index < _lenL or na(r)
    lowVol = atrVal < syminfo.mintick * _volFloorMult
    slopeDir = insufficientSlope or lowVol ? 0 : (tstat > _thresh ? 1 : (tstat < -_thresh ? -1 : 2))

    net = math.abs(close - close[_lenL])
    path = math.sum(math.abs(ta.change(close)), _lenL)
    er = path > 0 ? net / path : 0.0

    rawState = (structDir == 0 or slopeDir == 0) ? 0 : (structDir == slopeDir ? structDir : 2)

    var int confirmedState = 0
    var int pendingState = 0
    var int pendingCount = 0
    if rawState != confirmedState
        if rawState == pendingState
            pendingCount := pendingCount + 1
        else
            pendingState := rawState
            pendingCount := 1
        if pendingCount >= _hystH
            confirmedState := pendingState
            pendingCount := 0
    else
        pendingState := rawState
        pendingCount := 0

    // Looking one bar further back removes the "currently forming HTF bar"
    // case when this runs inside request.security() for a higher timeframe --
    // otherwise the state would flicker intrabar as that bar's close moves.
    outState = _waitForClose ? confirmedState[1] : confirmedState
    outRaw   = _waitForClose ? rawState[1] : rawState
    outER    = _waitForClose ? er[1] : er

    [outState, outRaw, outER]

// Chart timeframe: computed directly, no extra lag from the HTF-safety offset
[chState, chRaw, chER] = f_calc(fractalN, lenL, slopeThresh, hystH, atrLen, volFloorMult, false)

// Higher timeframes: always evaluated (cheap), shown only if enabled
[s2, r2, e2] = request.security(syminfo.tickerid, tf2, f_calc(fractalN, lenL, slopeThresh, hystH, atrLen, volFloorMult, waitForClose))
[s3, r3, e3] = request.security(syminfo.tickerid, tf3, f_calc(fractalN, lenL, slopeThresh, hystH, atrLen, volFloorMult, waitForClose))
[s4, r4, e4] = request.security(syminfo.tickerid, tf4, f_calc(fractalN, lenL, slopeThresh, hystH, atrLen, volFloorMult, waitForClose))
[s5, r5, e5] = request.security(syminfo.tickerid, tf5, f_calc(fractalN, lenL, slopeThresh, hystH, atrLen, volFloorMult, waitForClose))

// ---------- Visuals ----------
f_stateText(s) =>
    s == 1 ? "Up" : s == -1 ? "Down" : s == 2 ? "Mixed" : "Insufficient"

f_stateColor(s) =>
    s == 1 ? cUp : s == -1 ? cDown : s == 2 ? cMixed : cInsuf

f_bucket(er) =>
    er < 0.3 ? "Weak" : er < 0.6 ? "Moderate" : "Strong"

bgcolor(showBg ? color.new(f_stateColor(chState), bgOpacity) : na)
barcolor(showBars ? f_stateColor(chState) : na)

tablePos = tablePosStr == "Top Right" ? position.top_right : tablePosStr == "Top Left" ? position.top_left : tablePosStr == "Bottom Right" ? position.bottom_right : position.bottom_left

var table t = table.new(tablePos, 3, 6, border_width=1)
if showTable and barstate.islast
    table.cell(t, 0, 0, "Timeframe", bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(t, 1, 0, "State", bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(t, 2, 0, "Strength", bgcolor=color.new(color.gray, 70), text_color=color.white)

    table.cell(t, 0, 1, timeframe.period, text_color=color.white)
    table.cell(t, 1, 1, f_stateText(chState), bgcolor=f_stateColor(chState), text_color=color.white)
    table.cell(t, 2, 1, chState == 0 ? "—" : f_bucket(chER), text_color=color.white)

    if useTF2
        table.cell(t, 0, 2, tf2, text_color=color.white)
        table.cell(t, 1, 2, f_stateText(s2), bgcolor=f_stateColor(s2), text_color=color.white)
        table.cell(t, 2, 2, s2 == 0 ? "—" : f_bucket(e2), text_color=color.white)

    if useTF3
        table.cell(t, 0, 3, tf3, text_color=color.white)
        table.cell(t, 1, 3, f_stateText(s3), bgcolor=f_stateColor(s3), text_color=color.white)
        table.cell(t, 2, 3, s3 == 0 ? "—" : f_bucket(e3), text_color=color.white)

    if useTF4
        table.cell(t, 0, 4, tf4, text_color=color.white)
        table.cell(t, 1, 4, f_stateText(s4), bgcolor=f_stateColor(s4), text_color=color.white)
        table.cell(t, 2, 4, s4 == 0 ? "—" : f_bucket(e4), text_color=color.white)

    if useTF5
        table.cell(t, 0, 5, tf5, text_color=color.white)
        table.cell(t, 1, 5, f_stateText(s5), bgcolor=f_stateColor(s5), text_color=color.white)
        table.cell(t, 2, 5, s5 == 0 ? "—" : f_bucket(e5), text_color=color.white)

// ---------- Alerts ----------
alertcondition(ta.change(chState) != 0, title="Trend state changed (chart TF)", message="{{ticker}} trend state changed on {{interval}}")
