//@version=6
indicator("NQ Multi-Timeframe Trend Context", shorttitle="MTF Trend", overlay=true)

// State codes: 0 = insufficient, 1 = up, -1 = down, 2 = sideways, 3 = transition

// ---------- Inputs ----------
grpMode = "Trend Definition"
otcMode      = input.bool(true, "OTC mode (structure only, as taught in class)", group=grpMode, tooltip="On: direction comes from swing structure alone and anything that isn't a clean sequence is Sideways -- Bernd's rule from the supply & demand course. No Transition state exists in this mode. Off: structure must also agree with a volatility-normalized slope, and disagreement between them shows as Transition.")
structPivots = input.int(3, "Swing pivots per side", minval=2, maxval=4, group=grpMode, tooltip="3 = the OTC six-pivot rule (three highs and three lows; needs two consecutive higher highs AND higher lows for an uptrend). 2 = looser, calls trends about twice as often.")

grpPivot = "Pivot Detection (ZigZag)"
zzUsePct    = input.bool(false, "Use percentage threshold instead of ATR", group=grpPivot, tooltip="OTC marks pivots with a ZigZag set to a percentage (e.g. 3%). That works on one chart at a time, but a single percentage cannot serve a ladder from 5m to 1M -- on 5-minute bars a 3% ZigZag finds almost no pivots at all. ATR mode applies the same reversal logic scaled to each timeframe's own volatility.")
zzPct       = input.float(3.0, "Reversal threshold (%)", minval=0.05, step=0.05, group=grpPivot)
zzAtrMult   = input.float(1.5, "Reversal threshold (x ATR)", minval=0.1, step=0.1, group=grpPivot)

grpCore = "Core Engine"
lenL         = input.int(75, "Regression / efficiency lookback (bars)", minval=5, maxval=500, group=grpCore, tooltip="If a very high timeframe row shows Insufficient, lower this -- a monthly row needs this many monthly bars of history.")
slopeThresh  = input.float(1.5, "Slope significance (t-stat)", minval=0.1, step=0.1, group=grpCore)
rangeER      = input.float(0.25, "Range cutoff (efficiency ratio)", minval=0.0, maxval=1.0, step=0.05, group=grpCore, tooltip="When the two direction measures disagree, efficiency below this reads as chop (Sideways) rather than a regime change (Transition). Unused in OTC mode.")
hystH        = input.int(3, "Hysteresis (bars to confirm a flip)", minval=1, maxval=10, group=grpCore)
atrLen       = input.int(14, "ATR length", minval=1, group=grpCore)
volFloorMult = input.float(10.0, "Volatility floor (x min tick)", minval=0.0, group=grpCore)
waitForClose = input.bool(true, "Higher timeframes: wait for confirmed close (no repaint)", group=grpCore, tooltip="On: a higher-timeframe row only reflects fully closed bars, so it never repaints -- but a monthly row is then a month behind. Turn off to watch the developing bar.")

grpTF = "Timeframes"
use1  = input.bool(false, "5m",  inline="a", group=grpTF)
use2  = input.bool(false, "15m", inline="a", group=grpTF)
use3  = input.bool(true,  "30m", inline="a", group=grpTF)
use4  = input.bool(true,  "1H",  inline="a", group=grpTF)
use5  = input.bool(true,  "90m", inline="b", group=grpTF)
use6  = input.bool(true,  "4H",  inline="b", group=grpTF)
use7  = input.bool(true,  "6H",  inline="b", group=grpTF)
use8  = input.bool(true,  "1D",  inline="c", group=grpTF)
use9  = input.bool(false, "2D",  inline="c", group=grpTF)
use10 = input.bool(true,  "1W",  inline="c", group=grpTF)
use11 = input.bool(true,  "1M",  inline="c", group=grpTF)
showChartTF = input.bool(true, "Also show the chart's own timeframe", group=grpTF)

grpVis = "Visuals"
showBg      = input.bool(true, "Color chart background by primary trend", group=grpVis)
showBars    = input.bool(false, "Color candles by primary trend", group=grpVis)
showTable   = input.bool(true, "Show multi-timeframe table", group=grpVis)
simpleMode  = input.bool(false, "Simple mode (merge Transition into Sideways)", group=grpVis)
tablePosStr = input.string("Top Right", "Table position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=grpVis)
tableSize   = input.string("Small", "Table text size", options=["Tiny", "Small", "Normal"], group=grpVis)
bgOpacity   = input.int(85, "Background transparency", minval=0, maxval=95, group=grpVis)

grpColor = "Colors"
cUp    = input.color(color.new(color.green, 0), "Up", group=grpColor)
cDown  = input.color(color.new(color.red, 0), "Down", group=grpColor)
cSide  = input.color(color.new(color.blue, 20), "Sideways / range", group=grpColor)
cTrans = input.color(color.new(color.orange, 0), "Transition", group=grpColor)
cInsuf = input.color(color.new(color.gray, 40), "Insufficient data", group=grpColor)

// ---------- Core engine ----------
// Lengths are read from the global inputs rather than passed in as parameters:
// ta.atr() and several ta.* functions require a `simple int`, and Pine can
// downgrade a value to `series` when it crosses a function boundary inside
// request.security(). Reading the globals directly keeps the qualifier intact.
f_calc(_waitForClose) =>
    atrVal = ta.atr(atrLen)

    var float h1 = na
    var float h2 = na
    var float h3 = na
    var float h4 = na
    var float l1 = na
    var float l2 = na
    var float l3 = na
    var float l4 = na

    // ZigZag pivot detection, matching the tool OTC marks pivots with. A pivot
    // is recorded only once price retraces from the running extreme by the
    // reversal threshold, so pivots strictly alternate high/low and each is
    // fixed the moment it is recorded. The still-forming leg's extreme is never
    // published -- that is the part of a ZigZag that repaints.
    var int zzDir = 0
    var float zzExt = na
    thr = zzUsePct ? (na(zzExt) ? close : zzExt) * zzPct / 100.0 : atrVal * zzAtrMult

    if na(zzExt)
        zzExt := high
        zzDir := 1
    else if not na(thr) and thr > 0
        if zzDir > 0
            if high > zzExt
                zzExt := high
            else if (zzExt - low) >= thr
                h4 := h3
                h3 := h2
                h2 := h1
                h1 := zzExt
                zzDir := -1
                zzExt := low
        else
            if low < zzExt
                zzExt := low
            else if (high - zzExt) >= thr
                l4 := l3
                l3 := l2
                l2 := l1
                l1 := zzExt
                zzDir := 1
                zzExt := high

    // Newest-first. With structPivots = 3 this is the OTC six-pivot rule:
    // two consecutive higher highs AND higher lows make an uptrend.
    enough = structPivots == 2 ? not na(h2) and not na(l2) : structPivots == 3 ? not na(h3) and not na(l3) : not na(h4) and not na(l4)
    rising = structPivots == 2 ? (h1 > h2 and l1 > l2) : structPivots == 3 ? (h1 > h2 and h2 > h3 and l1 > l2 and l2 > l3) : (h1 > h2 and h2 > h3 and h3 > h4 and l1 > l2 and l2 > l3 and l3 > l4)
    falling = structPivots == 2 ? (h1 < h2 and l1 < l2) : structPivots == 3 ? (h1 < h2 and h2 < h3 and l1 < l2 and l2 < l3) : (h1 < h2 and h2 < h3 and h3 < h4 and l1 < l2 and l2 < l3 and l3 < l4)
    // 0 = not enough swings, 1 = rising sequence, -1 = falling, 2 = neither
    structDir = not enough ? 0 : rising ? 1 : falling ? -1 : 2

    float idx = bar_index
    r = ta.correlation(close, idx, lenL)
    denom = 1 - r * r
    tstat = denom > 0.0001 ? r * math.sqrt(lenL - 2) / math.sqrt(denom) : (r > 0 ? 999.0 : -999.0)
    lowVol = atrVal < syminfo.mintick * volFloorMult
    slopeBlind = bar_index < lenL or na(r) or lowVol
    // 0 = unusable, 1 = up, -1 = down, 2 = statistically flat
    slopeDir = slopeBlind ? 0 : (tstat > slopeThresh ? 1 : (tstat < -slopeThresh ? -1 : 2))

    net = math.abs(close - close[lenL])
    path = math.sum(math.abs(ta.change(close)), lenL)
    er = path > 0 ? net / path : 0.0

    int rawState = 0
    if otcMode
        // As taught: structure alone decides and the residual is Sideways,
        // so no Transition state exists in this mode.
        rawState := structDir == 0 ? 0 : structDir == 1 ? 1 : structDir == -1 ? -1 : 2
    else if structDir == 0 or slopeDir == 0
        rawState := 0
    else if structDir == 1 and slopeDir == 1
        rawState := 1
    else if structDir == -1 and slopeDir == -1
        rawState := -1
    else if structDir == 2 and slopeDir == 2
        rawState := 2
    else
        // The measures disagree. Efficiency decides what kind of disagreement:
        // price going nowhere is chop, price travelling decisively is a real
        // regime handover. Without this, ranges read as permanent Transition,
        // because a t-stat over a noisy window is almost never flat.
        rawState := er < rangeER ? 2 : 3

    var int confirmedState = 0
    var int pendingState = 0
    var int pendingCount = 0
    int stateBefore = confirmedState

    if rawState != confirmedState
        if rawState == pendingState
            pendingCount := pendingCount + 1
        else
            pendingState := rawState
            pendingCount := 1
        if pendingCount >= hystH
            confirmedState := pendingState
            pendingCount := 0
    else
        pendingState := rawState
        pendingCount := 0

    // Reporting the previous bar's values removes the "currently forming HTF bar"
    // case when this runs inside request.security() -- otherwise every reading
    // would drift intrabar as that higher-timeframe bar's close moves around.
    var int prevRaw = 0
    var float prevER = 0.0
    var float prevT = 0.0
    var int prevStruct = 0
    var int prevSlope = 0

    outState  = _waitForClose ? stateBefore : confirmedState
    outRaw    = _waitForClose ? prevRaw : rawState
    outER     = _waitForClose ? prevER : er
    outT      = _waitForClose ? prevT : tstat
    outStruct = _waitForClose ? prevStruct : structDir
    outSlope  = _waitForClose ? prevSlope : slopeDir

    prevRaw := rawState
    prevER := er
    prevT := tstat
    prevStruct := structDir
    prevSlope := slopeDir

    // Four small ints packed into one float so each timeframe costs three
    // series instead of six -- with eleven timeframes requested, that keeps
    // the script clear of Pine's request.*() budget.
    code = (outState + 2) + 10 * (outRaw + 2) + 100 * (outStruct + 2) + 1000 * (outSlope + 2)
    [code, outER, outT]

f_state(c)  => na(c) ? 0 : math.round(c % 10) - 2
f_raw(c)    => na(c) ? 0 : math.round(math.floor(c / 10) % 10) - 2
f_struct(c) => na(c) ? 0 : math.round(math.floor(c / 100) % 10) - 2
f_slope(c)  => na(c) ? 0 : math.round(math.floor(c / 1000) % 10) - 2

// Chart timeframe: computed directly, so it carries no extra higher-timeframe delay
[chCode, chER, chT] = f_calc(false)

[c1, e1, t1]    = request.security(syminfo.tickerid, "5",   f_calc(waitForClose), lookahead=barmerge.lookahead_off)
[c2, e2, t2]    = request.security(syminfo.tickerid, "15",  f_calc(waitForClose), lookahead=barmerge.lookahead_off)
[c3, e3, t3]    = request.security(syminfo.tickerid, "30",  f_calc(waitForClose), lookahead=barmerge.lookahead_off)
[c4, e4, t4]    = request.security(syminfo.tickerid, "60",  f_calc(waitForClose), lookahead=barmerge.lookahead_off)
[c5, e5, t5]    = request.security(syminfo.tickerid, "90",  f_calc(waitForClose), lookahead=barmerge.lookahead_off)
[c6, e6, t6]    = request.security(syminfo.tickerid, "240", f_calc(waitForClose), lookahead=barmerge.lookahead_off)
[c7, e7, t7]    = request.security(syminfo.tickerid, "360", f_calc(waitForClose), lookahead=barmerge.lookahead_off)
[c8, e8, t8]    = request.security(syminfo.tickerid, "D",   f_calc(waitForClose), lookahead=barmerge.lookahead_off)
[c9, e9, t9]    = request.security(syminfo.tickerid, "2D",  f_calc(waitForClose), lookahead=barmerge.lookahead_off)
[c10, e10, t10] = request.security(syminfo.tickerid, "W",   f_calc(waitForClose), lookahead=barmerge.lookahead_off)
[c11, e11, t11] = request.security(syminfo.tickerid, "M",   f_calc(waitForClose), lookahead=barmerge.lookahead_off)

// A lower timeframe pulled into a higher-timeframe chart returns only the last
// value inside each chart bar, which is not a state this engine can stand behind.
chartSec = timeframe.in_seconds(timeframe.period)
ok1  = use1  and timeframe.in_seconds("5")   >= chartSec
ok2  = use2  and timeframe.in_seconds("15")  >= chartSec
ok3  = use3  and timeframe.in_seconds("30")  >= chartSec
ok4  = use4  and timeframe.in_seconds("60")  >= chartSec
ok5  = use5  and timeframe.in_seconds("90")  >= chartSec
ok6  = use6  and timeframe.in_seconds("240") >= chartSec
ok7  = use7  and timeframe.in_seconds("360") >= chartSec
ok8  = use8  and timeframe.in_seconds("D")   >= chartSec
ok9  = use9  and timeframe.in_seconds("2D")  >= chartSec
ok10 = use10 and timeframe.in_seconds("W")   >= chartSec
ok11 = use11 and timeframe.in_seconds("M")   >= chartSec

// ---------- Display helpers ----------
f_view(s) =>
    simpleMode and s == 3 ? 2 : s

f_stateText(s) =>
    s == 1 ? "Up" : s == -1 ? "Down" : s == 2 ? "Sideways" : s == 3 ? "Transition" : "Insufficient"

f_stateColor(s) =>
    s == 1 ? cUp : s == -1 ? cDown : s == 2 ? cSide : s == 3 ? cTrans : cInsuf

f_dirText(d) =>
    d == 1 ? "Up" : d == -1 ? "Down" : d == 2 ? "No clear sequence" : "Not enough data"

f_bucket(er) =>
    er < 0.3 ? "Weak" : er < 0.6 ? "Moderate" : "Strong"

f_tip(_code, _er, _t) =>
    s = "State: " + f_stateText(f_view(f_state(_code)))
    s := s + "   (raw, before hysteresis: " + f_stateText(f_raw(_code)) + ")"
    s := s + "\nStructure: " + f_dirText(f_struct(_code)) + "  [" + str.tostring(structPivots) + " pivots/side, " + (zzUsePct ? str.tostring(zzPct) + "% zigzag" : str.tostring(zzAtrMult) + "x ATR zigzag") + "]"
    s := s + (otcMode ? "\nSlope: not used in OTC mode" : "\nSlope: t-stat " + str.tostring(_t, "#.##") + "  -> " + f_dirText(f_slope(_code)))
    s := s + "\nEfficiency: " + str.tostring(_er, "#.##") + "  (" + f_bucket(_er) + ")"
    s

// ---------- Visuals ----------
chState = f_state(chCode)
chView = f_view(chState)
bgcolor(showBg ? color.new(f_stateColor(chView), bgOpacity) : na)
barcolor(showBars ? f_stateColor(chView) : na)

tablePos = tablePosStr == "Top Right" ? position.top_right : tablePosStr == "Top Left" ? position.top_left : tablePosStr == "Bottom Right" ? position.bottom_right : position.bottom_left
txtSize = tableSize == "Tiny" ? size.tiny : tableSize == "Normal" ? size.normal : size.small

var table t = table.new(tablePos, 3, 14, border_width=1)

f_row(_row, _label, _code, _er, _t) =>
    v = f_view(f_state(_code))
    tip = f_tip(_code, _er, _t)
    table.cell(t, 0, _row, _label, text_color=chart.fg_color, text_size=txtSize, tooltip=tip)
    table.cell(t, 1, _row, f_stateText(v), bgcolor=f_stateColor(v), text_color=color.white, text_size=txtSize, tooltip=tip)
    table.cell(t, 2, _row, v == 0 ? "-" : f_bucket(_er), text_color=chart.fg_color, text_size=txtSize, tooltip=tip)

if showTable and barstate.islast
    hdr = color.new(chart.fg_color, 80)
    table.cell(t, 0, 0, otcMode ? "TF (OTC)" : "TF", bgcolor=hdr, text_color=chart.fg_color, text_size=txtSize)
    table.cell(t, 1, 0, "State", bgcolor=hdr, text_color=chart.fg_color, text_size=txtSize)
    table.cell(t, 2, 0, "Strength", bgcolor=hdr, text_color=chart.fg_color, text_size=txtSize)

    int row = 0
    if showChartTF
        row += 1
        f_row(row, "chart", chCode, chER, chT)
    if ok1
        row += 1
        f_row(row, "5m", c1, e1, t1)
    if ok2
        row += 1
        f_row(row, "15m", c2, e2, t2)
    if ok3
        row += 1
        f_row(row, "30m", c3, e3, t3)
    if ok4
        row += 1
        f_row(row, "1H", c4, e4, t4)
    if ok5
        row += 1
        f_row(row, "90m", c5, e5, t5)
    if ok6
        row += 1
        f_row(row, "4H", c6, e6, t6)
    if ok7
        row += 1
        f_row(row, "6H", c7, e7, t7)
    if ok8
        row += 1
        f_row(row, "1D", c8, e8, t8)
    if ok9
        row += 1
        f_row(row, "2D", c9, e9, t9)
    if ok10
        row += 1
        f_row(row, "1W", c10, e10, t10)
    if ok11
        row += 1
        f_row(row, "1M", c11, e11, t11)

    ups = (ok1 and f_state(c1) == 1 ? 1 : 0) + (ok2 and f_state(c2) == 1 ? 1 : 0) + (ok3 and f_state(c3) == 1 ? 1 : 0) + (ok4 and f_state(c4) == 1 ? 1 : 0) + (ok5 and f_state(c5) == 1 ? 1 : 0) + (ok6 and f_state(c6) == 1 ? 1 : 0) + (ok7 and f_state(c7) == 1 ? 1 : 0) + (ok8 and f_state(c8) == 1 ? 1 : 0) + (ok9 and f_state(c9) == 1 ? 1 : 0) + (ok10 and f_state(c10) == 1 ? 1 : 0) + (ok11 and f_state(c11) == 1 ? 1 : 0)
    downs = (ok1 and f_state(c1) == -1 ? 1 : 0) + (ok2 and f_state(c2) == -1 ? 1 : 0) + (ok3 and f_state(c3) == -1 ? 1 : 0) + (ok4 and f_state(c4) == -1 ? 1 : 0) + (ok5 and f_state(c5) == -1 ? 1 : 0) + (ok6 and f_state(c6) == -1 ? 1 : 0) + (ok7 and f_state(c7) == -1 ? 1 : 0) + (ok8 and f_state(c8) == -1 ? 1 : 0) + (ok9 and f_state(c9) == -1 ? 1 : 0) + (ok10 and f_state(c10) == -1 ? 1 : 0) + (ok11 and f_state(c11) == -1 ? 1 : 0)
    shown = (ok1 ? 1 : 0) + (ok2 ? 1 : 0) + (ok3 ? 1 : 0) + (ok4 ? 1 : 0) + (ok5 ? 1 : 0) + (ok6 ? 1 : 0) + (ok7 ? 1 : 0) + (ok8 ? 1 : 0) + (ok9 ? 1 : 0) + (ok10 ? 1 : 0) + (ok11 ? 1 : 0)
    others = shown - ups - downs
    row += 1
    alignTxt = str.tostring(ups) + " up / " + str.tostring(downs) + " dn / " + str.tostring(others) + " flat"
    alignCol = shown > 0 and ups == shown ? cUp : shown > 0 and downs == shown ? cDown : color.new(chart.fg_color, 80)
    alignTip = "How many of the displayed timeframes agree. All-up or all-down means the whole ladder is aligned; a split means higher and lower timeframes disagree."
    table.cell(t, 0, row, "Align", text_color=chart.fg_color, text_size=txtSize, tooltip=alignTip)
    table.cell(t, 1, row, alignTxt, bgcolor=alignCol, text_color=shown > 0 and (ups == shown or downs == shown) ? color.white : chart.fg_color, text_size=txtSize, tooltip=alignTip)
    table.cell(t, 2, row, "", text_size=txtSize)

// ---------- Alerts ----------
alertcondition(ta.change(chState) != 0, title="Trend state changed (chart TF)", message="{{ticker}} trend state changed on {{interval}}")
